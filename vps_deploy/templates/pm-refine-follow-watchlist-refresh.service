[Unit]
Description=PM Refine Follow high-score watchlist refresh
Wants=network-online.target
After=network-online.target
Conflicts=pm-refine-follow-auto-screen.service
OnSuccess=pm-refine-follow-auto-screen.service
OnFailure=pm-refine-follow-auto-screen.service

[Service]
Type=oneshot
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=PM_APP_ROOT=__APP_DIR__
ExecStartPre=-__APP_DIR__/.venv/bin/python -m auto_screen.cli --config __CONFIG_DIR__/auto_screen_config.json checkpoint-state-db --timeout 60
ExecStart=__APP_DIR__/.venv/bin/python -m auto_screen.cli --config __CONFIG_DIR__/auto_screen_config.json refresh-watchlist --min-score 60 --limit 200 --interval-hours 48
MemoryHigh=550M
MemoryMax=750M
OOMPolicy=stop
Nice=5
