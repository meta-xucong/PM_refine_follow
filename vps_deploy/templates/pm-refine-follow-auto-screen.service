[Unit]
Description=PM Refine Follow auto screen runner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=4

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=PM_APP_ROOT=__APP_DIR__
Environment=PM_DATA_DIR=__DATA_DIR__
Environment=PM_UI_DIR=__DATA_DIR__/dashboard
Environment=PM_AUTO_CONFIG=__CONFIG_DIR__/auto_screen_config.json
ExecStartPre=-__APP_DIR__/.venv/bin/python -m auto_screen.cli --config __CONFIG_DIR__/auto_screen_config.json checkpoint-state-db --timeout 30
ExecStart=__APP_DIR__/.venv/bin/python -m auto_screen.cli --config __CONFIG_DIR__/auto_screen_config.json run
Restart=on-failure
RestartSec=60
KillMode=control-group
TimeoutStopSec=60
MemoryHigh=1050M
MemoryMax=1400M
OOMPolicy=stop
Nice=5
TasksMax=128

[Install]
WantedBy=multi-user.target
