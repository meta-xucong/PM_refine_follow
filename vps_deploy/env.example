# Git source
REPO_URL=https://github.com/meta-xucong/PM_refine_follow.git
BRANCH=main

# Linux layout
APP_DIR=/opt/pm-refine-follow/current
CONFIG_DIR=/etc/pm-refine-follow
DATA_DIR=/var/lib/pm-refine-follow
LOG_DIR=/var/log/pm-refine-follow
RUN_USER=pmfollow
RUN_GROUP=pmfollow

# Dashboard
DASHBOARD_PORT=8787
AUTOSTART_SCAN=1

# Nginx reverse proxy and login
# Use your domain, public IP, or "_" for a catch-all server block.
DOMAIN=_
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=
DISABLE_NGINX_DEFAULT=1

# Optional HTTPS. DOMAIN must be a real DNS name pointing to this VPS.
ENABLE_LETSENCRYPT=0
LETSENCRYPT_EMAIL=

# Optional ServerChan Turbo SendKey. Empty means set it later in dashboard.
SCT_SENDKEY=
