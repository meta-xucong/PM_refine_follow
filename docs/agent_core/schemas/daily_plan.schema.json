{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DailyPlan",
  "type": "object",
  "required": [
    "date",
    "summary",
    "scan_plan",
    "recheck_accounts",
    "temporary_thresholds",
    "requires_human_approval",
    "risks"
  ],
  "properties": {
    "date": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "scan_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shard", "priority", "reason"],
        "properties": {
          "shard": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "recheck_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account_address", "priority", "reason"],
        "properties": {
          "account_address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "temporary_thresholds": {
      "type": "object",
      "properties": {
        "min_data_quality": { "type": "number", "minimum": 0, "maximum": 10 },
        "max_avg_trades_per_day": { "type": "number", "minimum": 0 },
        "min_copy_capacity": { "type": "number", "minimum": 0, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "requires_human_approval": {
      "type": "boolean"
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

