{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateReview",
  "type": "object",
  "required": [
    "agent_verdict",
    "confidence",
    "copy_style",
    "human_review_priority",
    "main_reason",
    "risk_summary",
    "recommended_followup",
    "tags",
    "safety_overrides"
  ],
  "properties": {
    "agent_verdict": {
      "type": "string",
      "enum": ["strong_candidate", "watchlist", "reject", "recheck_later"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "copy_style": {
      "type": "string",
      "enum": ["broad", "selective", "event_filtered", "manual_only", "none"]
    },
    "human_review_priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "main_reason": {
      "type": "string",
      "minLength": 1
    },
    "risk_summary": {
      "type": "string",
      "minLength": 1
    },
    "recommended_followup": {
      "type": "string",
      "minLength": 1
    },
    "positive_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "negative_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety_overrides": {
      "type": "array",
      "items": { "type": "string" }
    },
    "needs_human_confirmation": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}

